+// ---- Single-page dashboard (Game Boy) -----------------------------------------
+// The Game Boy has one player, an 8-button pad and a short settings list, so
+// instead of hiding them behind "Configure" and "Settings" sub-pages everything
+// lives on the dashboard: GAME card on the left; on the right the CONTROLS card
+// (input source + click-to-rebind key chips) above the DISPLAY and AUDIO cards.
+bool single_page_dashboard(const LauncherModel* m) {
+    const SystemProfile* prof = (const SystemProfile*)m->profile;
+    return prof && prof->id &&
+           (strcmp(prof->id, "gb") == 0 || strcmp(prof->id, "gbc") == 0);
+}
+
+void draw_inline_controls(LauncherModel* m, const LauncherTheme& th) {
+    const int p = 0;
+    m->cfg_player = p;   // capture + bind writes address this player
+    const SystemProfile* prof = (const SystemProfile*)m->profile;
+    const ControllerSpec& spec = prof->controller;
+    if (!begin_panel("ctl_inline", 0)) { end_panel(); return; }
+    eyebrow("CONTROLS");
+
+    if (!m->lock_device) {
+        ImGui::AlignTextToFramePadding();
+        ImGui::TextColored(col(th.text_muted), "Input");
+        ImGui::SameLine(px(80.0f));
+        ImGui::SetNextItemWidth(ImGui::GetContentRegionAvail().x);
+        if (ImGui::BeginCombo("##src_inline", launcher_model_player_src_label(m, p))) {
+            draw_source_selectables(m, p);
+            ImGui::EndCombo();
+        }
+        ImGui::Dummy(ImVec2(0, px(4)));
+    }
+
+    if (!m->hide_rebind) {
+        const int nbtn = launcher_model_active_button_count(m, p);
+        float label_w = px(64.0f);
+        for (int b = 0; b < nbtn; ++b) {
+            float w = ImGui::CalcTextSize(spec.buttons[b].label).x + px(14.0f);
+            if (w > label_w) label_w = w;
+        }
+        // Two cells per row (label + key chip), placed explicitly so both
+        // columns line up regardless of label length.
+        const float gap    = px(th.spacing_md);
+        const float row0_x = ImGui::GetCursorPosX();
+        const float cell_w = (ImGui::GetContentRegionAvail().x - gap) * 0.5f;
+        const float chip_w = cell_w - label_w;
+        for (int b = 0; b < nbtn; ++b) {
+            const int c = b & 1;
+            const float x = row0_x + c * (cell_w + gap);
+            if (c) ImGui::SameLine(x); else ImGui::SetCursorPosX(x);
+            ImGui::PushID(b);
+            ImGui::AlignTextToFramePadding();
+            ImGui::TextColored(col(th.text_muted), "%s", spec.buttons[b].label);
+            ImGui::SameLine(x + label_w);
+            const bool cap = m->capturing && !m->capture_pad && m->capture_btn == b;
+            if (cap) {
+                ImGui::PushStyleColor(ImGuiCol_Button,        col(th.accent));
+                ImGui::PushStyleColor(ImGuiCol_ButtonHovered, col(th.accent));
+                ImGui::PushStyleColor(ImGuiCol_ButtonActive,  col(th.accent_dim));
+                ImGui::PushStyleColor(ImGuiCol_Text,          col(th.accent_text));
+            }
+            if (ImGui::Button(cap ? "Press a key..." : m->binds[p][b], ImVec2(chip_w, 0)))
+                launcher_model_begin_capture(m, b);
+            if (cap) ImGui::PopStyleColor(4);
+            ImGui::PopID();
+        }
+        ImGui::Dummy(ImVec2(0, px(4)));
+        if (ImGui::Button("Reset to defaults")) launcher_binds_reset_player(m, p + 1);
+        ImGui::SameLine();
+        ImGui::AlignTextToFramePadding();
+        if (m->capturing) ImGui::TextColored(col(th.warn), "Listening... (Esc cancels)");
+        else              ImGui::TextColored(col(th.text_muted), "Click a key to change it.");
+    }
+    end_panel();
+}
+
+void draw_single_page_dashboard(LauncherModel* m, const LauncherTheme& th, int logical_w) {
+    const SystemProfile* prof = (const SystemProfile*)m->profile;
+    const LauncherPanel* game_p  = find_composed(prof->panels_dashboard, "game", m);
+    const LauncherPanel* video_p = find_composed(prof->panels_settings, "video", m);
+    const LauncherPanel* audio_p = find_composed(prof->panels_settings, "audio", m);
+    const float gap = px(th.spacing_md);
+
+    if (logical_w < 820) {   // narrow window: one scrolling column
+        if (game_p) { g_game_fill_h = false; game_p->draw(m, &th); ImGui::Spacing(); }
+        draw_inline_controls(m, th);
+        if (video_p) { ImGui::Spacing(); begin_container("sp_v", ImVec2(0, px(250))); video_p->draw(m, &th); end_container(); }
+        if (audio_p) { ImGui::Spacing(); begin_container("sp_a", ImVec2(0, px(200))); audio_p->draw(m, &th); end_container(); }
+        return;
+    }
+
+    if (game_p) {
+        g_game_fill_h = true;
+        begin_container("sp_l", ImVec2(px(340), 0));
+        game_p->draw(m, &th);
+        end_container();
+        ImGui::SameLine(0, gap);
+    }
+    begin_container("sp_r", ImVec2(0, 0), ImGuiChildFlags_None, ImGuiWindowFlags_NoScrollbar);
+        draw_inline_controls(m, th);
+        ImGui::Dummy(ImVec2(0, gap - ImGui::GetStyle().ItemSpacing.y));
+        const ImVec2 avail = ImGui::GetContentRegionAvail();
+        const float rest_h = avail.y > px(160) ? avail.y : px(160);
+        const float video_w = (avail.x - gap) * 0.58f;
+        if (video_p) {
+            begin_container("sp_v", ImVec2((video_p && audio_p) ? video_w : 0, rest_h));
+            video_p->draw(m, &th);
+            end_container();
+        }
+        if (video_p && audio_p) ImGui::SameLine(0, gap);
+        if (audio_p) {
+            begin_container("sp_a", ImVec2(0, rest_h));
+            audio_p->draw(m, &th);
+            end_container();
+        }
+    end_container();
+}
