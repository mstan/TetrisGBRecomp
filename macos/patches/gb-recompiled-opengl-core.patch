diff --git a/runtime/include/gbrt_gl.h b/runtime/include/gbrt_gl.h
new file mode 100644
index 0000000..f114985
--- /dev/null
+++ b/runtime/include/gbrt_gl.h
@@ -0,0 +1,32 @@
+/*
+ * gbrt_gl.h — one place that picks the GL header for the runtime.
+ *
+ * Default: GLES 2.0 (SDL_opengles2.h) — Windows/ANGLE, Linux Mesa, Android.
+ * GBRT_GL_CORE: desktop OpenGL 3.2 Core + GLSL 150. macOS has no GLES at
+ * all (no system EGL), so this is ON by default there; it can also be forced
+ * on Linux (-DGBRT_GL_CORE=ON) to exercise the same path on Mesa.
+ */
+#ifndef GBRT_GL_H
+#define GBRT_GL_H
+
+#if defined(__APPLE__) && !defined(GBRT_GL_CORE)
+#define GBRT_GL_CORE 1
+#endif
+
+#if defined(GBRT_GL_CORE)
+#  if defined(__APPLE__)
+#    ifndef GL_SILENCE_DEPRECATION
+#      define GL_SILENCE_DEPRECATION 1
+#    endif
+#    include <OpenGL/gl3.h>
+#  else
+#    ifndef GL_GLEXT_PROTOTYPES
+#      define GL_GLEXT_PROTOTYPES 1
+#    endif
+#    include <GL/glcorearb.h>
+#  endif
+#else
+#  include <SDL_opengles2.h>
+#endif
+
+#endif /* GBRT_GL_H */
