 }
@@ -203,6 +240,9 @@ void gb_shader_pipeline_destroy(GBShaderPipeline* p) {
         if (e.program) glDeleteProgram(e.program);
     }
     if (p->quad_vbo) glDeleteBuffers(1, &p->quad_vbo);
+#if defined(GBRT_GL_CORE)
+    if (p->quad_vao) glDeleteVertexArrays(1, &p->quad_vao);
+#endif
     delete p;
 }
 
@@ -277,6 +317,11 @@ void gb_shader_pipeline_draw(GBShaderPipeline* p,
         x0, y1, 0.0f, 1.0f,
     };
 
+#if defined(GBRT_GL_CORE)
+    GLint prev_vao = 0;
+    glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &prev_vao);
+    glBindVertexArray(p->quad_vao);
+#endif
     glBindBuffer(GL_ARRAY_BUFFER, p->quad_vbo);
     glBufferData(GL_ARRAY_BUFFER, sizeof(verts), verts, GL_STREAM_DRAW);
 
@@ -309,4 +354,7 @@ void gb_shader_pipeline_draw(GBShaderPipeline* p,
 
     if (e.a_pos >= 0) glDisableVertexAttribArray(e.a_pos);
     if (e.a_uv  >= 0) glDisableVertexAttribArray(e.a_uv);
+#if defined(GBRT_GL_CORE)
+    glBindVertexArray((GLuint)prev_vao);
+#endif
 }
