diff --git a/runtime/src/shader_pipeline.cpp b/runtime/src/shader_pipeline.cpp
index 3390e22..59f342f 100644
--- a/runtime/src/shader_pipeline.cpp
+++ b/runtime/src/shader_pipeline.cpp
@@ -9,7 +9,7 @@
 #include "shader_pipeline.h"
 
 #include <SDL.h>
-#include <SDL_opengles2.h>
+#include "gbrt_gl.h"
 
 #include <stdio.h>
 #include <stdlib.h>
@@ -124,7 +124,40 @@ bool log_link(GLuint prog, const char* label) {
     return false;
 }
 
+#if defined(GBRT_GL_CORE)
+/* Desktop GL Core (macOS) rejects GLSL ES 1.00. Rewrite the `#version 100`
+ * sources (embedded and user .frag.glsl overrides alike) to GLSL 1.50:
+ * drop the original #version line and map attribute/varying/texture2D/
+ * gl_FragColor onto their 1.50 spellings. `precision` is legal in 1.50. */
+std::string to_glsl150(const char* src, bool fragment) {
+    std::string body(src ? src : "");
+    size_t v = body.find("#version");
+    if (v != std::string::npos) {
+        size_t eol = body.find('\n', v);
+        body.replace(v, (eol == std::string::npos ? body.size() : eol) - v, "");
+    }
+    std::string out = "#version 150\n";
+    if (fragment) {
+        out += "#define varying in\n"
+               "#define texture2D texture\n"
+               "out vec4 gbrt_FragColor;\n"
+               "#define gl_FragColor gbrt_FragColor\n";
+    } else {
+        out += "#define attribute in\n"
+               "#define varying out\n";
+    }
+    out += "#line 1\n";
+    return out + body;
+}
+#endif
+
 GLuint compile_program(const char* vs_src, const char* fs_src, const char* label) {
+#if defined(GBRT_GL_CORE)
+    const std::string vs_core = to_glsl150(vs_src, false);
+    const std::string fs_core = to_glsl150(fs_src, true);
+    vs_src = vs_core.c_str();
+    fs_src = fs_core.c_str();
+#endif
     GLuint vs = glCreateShader(GL_VERTEX_SHADER);
     glShaderSource(vs, 1, &vs_src, NULL);
     glCompileShader(vs);
@@ -184,6 +217,7 @@ struct GBShaderPipeline {
     std::vector<ShaderEntry> shaders;
     int    active = -1;
     GLuint quad_vbo = 0;
+    GLuint quad_vao = 0;   /* GBRT_GL_CORE only: Core profile needs a bound VAO */
     std::string override_dir;
 };
 
